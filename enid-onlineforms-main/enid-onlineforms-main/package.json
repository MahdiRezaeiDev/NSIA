        "laravel-mix": "^4.0.7",
        "lodash": "^4.17.5",
        "popper.js": "^1.12",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.15.2",
        "sass-loader": "^7.1.0",
        "vue": "^2.5.17",
        "vue-template-compiler": "^2.6.11"
    },
    "dependencies": {
        "angular": "^1.7.8",
        "angular-route": "^1.7.8",
        "angular-ui-grid": "^4.8.0",
        "laravel-echo": "^1.19.0",
        "ng-recaptcha": "^5.0.0",
        "print-js": "^1.0.61",
